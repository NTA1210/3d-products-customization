generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id
  email               String               @unique
  assets              ModelAsset[]
  projects            Project[]
  presets             UserPreset[]
  renderJobs          RenderJob[]
  aiRequests          AIRequest[]
  manufacturingChecks ManufacturingCheck[]
  quoteRequests       QuoteRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

model ModelAsset {
  id                  String          @id @default(cuid())
  ownerId             String?
  owner               User?           @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  name                String
  originalFilename    String
  contentType         String?
  sizeBytes           Int?
  sourceUrl           String?
  sourceObjectKey     String?
  normalizedGlbUrl    String?
  normalizedObjectKey String?
  thumbnailUrl        String?
  validationJson      Json?
  analysisJson        Json?
  analysisVersion     Int?
  status              String          @default("AWAITING_UPLOAD")
  unit                String          @default("mm")
  manifests           ModelManifest[]
  projects            Project[]
  jobs                Job[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([ownerId])
}

model ModelManifest {
  id           String     @id @default(cuid())
  modelAssetId String
  version      Int
  manifestJson Json
  modelAsset   ModelAsset @relation(fields: [modelAssetId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([modelAssetId, version])
}

model Project {
  id                  String               @id @default(cuid())
  userId              String
  modelAssetId        String
  name                String
  activeVersionId     String?
  user                User                 @relation(fields: [userId], references: [id])
  modelAsset          ModelAsset           @relation(fields: [modelAssetId], references: [id])
  versions            ModelVersion[]
  renderJobs          RenderJob[]
  aiRequests          AIRequest[]
  manufacturingChecks ManufacturingCheck[]
  quoteRequests       QuoteRequest[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([userId])
}

model ModelVersion {
  id                String         @id @default(cuid())
  projectId         String
  name              String
  configurationJson Json
  previewUrl        String?
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  quoteRequests     QuoteRequest[]
  createdAt         DateTime       @default(now())
}

model MaterialPreset {
  id             String   @id
  name           String
  category       String
  propertiesJson Json
  styleTags      String[]
  active         Boolean  @default(true)
}

model ComponentVariant {
  id                String  @id
  groupId           String
  role              String
  name              String
  assetUrl          String
  compatibilityJson Json
  metadataJson      Json
  active            Boolean @default(true)
}

model StylePreset {
  id          String   @id
  name        String
  description String?
  styleTags   String[]
  rulesJson   Json
  active      Boolean  @default(true)
}

model UserPreset {
  id        String   @id @default(cuid())
  userId    String
  name      String
  rulesJson Json
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ManufacturingRule {
  id       String  @id
  name     String
  type     String
  severity String
  ruleJson Json
  active   Boolean @default(true)
}

model ManufacturingCheck {
  id                String   @id @default(cuid())
  userId            String
  projectId         String
  modelVersionId    String?
  configurationJson Json
  issuesJson        Json
  geometryJson      Json?
  status            String   @default("COMPLETED")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([projectId])
}

model AIRequest {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  type      String
  provider  String
  model     String?
  status    String
  inputJson Json
  resultJson Json?
  error     String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([projectId])
}

model Job {
  id            String      @id @default(cuid())
  type          String
  status        String
  payload       Json
  result        Json?
  failureReason String?
  bullmqJobId   String?     @unique
  modelAssetId  String?
  modelAsset    ModelAsset? @relation(fields: [modelAssetId], references: [id], onDelete: SetNull)
  renderJob     RenderJob?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model RenderJob {
  id                String   @id @default(cuid())
  userId            String
  projectId         String
  jobId             String   @unique
  sourceExportJobId String
  mode              String
  quality           String
  frameCount        Int
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  job                Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([projectId])
}

model CollectionProduct {
  id                String   @id
  name              String
  category          String
  styleTags         String[]
  materialTags      String[]
  colorFamily       String?
  componentFeatures String[]
  thumbnailUrl      String?
  metadataJson      Json
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([category])
}

model Workshop {
  id               String         @id
  name             String
  contactJson      Json
  capabilitiesJson Json
  active           Boolean        @default(true)
  quoteRequests    QuoteRequest[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model QuoteRequest {
  id             String       @id @default(cuid())
  userId         String
  projectId      String
  modelVersionId String
  workshopId     String?
  status         String       @default("DRAFT")
  customerNote   String?
  payloadJson    Json
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id], onDelete: Restrict)
  workshop       Workshop?    @relation(fields: [workshopId], references: [id], onDelete: SetNull)
  quotes         Quote[]
  submittedAt    DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([projectId])
  @@index([workshopId])
}

model Quote {
  id             String       @id @default(cuid())
  quoteRequestId String
  status         String       @default("RECEIVED")
  amountCents    Int?
  currency       String       @default("USD")
  leadTimeDays   Int?
  terms          String?
  responseJson   Json?
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([quoteRequestId])
}
