DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product3d
REDIS_URL=redis://localhost:6379

# Supabase Storage (create a PRIVATE bucket with this name)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=product3d

# Browser-safe Supabase values used only for signed uploads.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
NEXT_PUBLIC_API_URL=http://localhost:4000

AI_PROVIDER=disabled
