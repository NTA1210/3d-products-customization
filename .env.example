# Supabase Database (Postgres). For local development and persistent API/workers,
# copy the Session pooler connection string (port 5432) from Supabase Dashboard -> Connect.
# URL-encode special characters in the database password when necessary.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres
REDIS_URL=redis://localhost:6379

# Supabase Auth + Storage
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=product3d
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional local developer account bootstrap. Do not commit real credentials.
DEV_USER_EMAIL=dev@example.com
DEV_USER_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD

NEXT_PUBLIC_API_URL=http://localhost:4000
MAX_ASSET_BYTES=262144000
ASSET_TRIANGLE_WARNING_THRESHOLD=500000
ASSET_TEXTURE_RESOLUTION_WARNING_THRESHOLD=4096
ASSET_TEXTURE_BYTES_WARNING_THRESHOLD=16777216
ASSET_ROOT_SCALE_MIN=0.001
ASSET_ROOT_SCALE_MAX=1000

# Observability. Leave METRICS_BEARER_TOKEN empty for local-only/open scraping.
METRICS_SAMPLE_LIMIT=10000
METRICS_BEARER_TOKEN=

# AI is server-side only. Keep OPENAI_API_KEY out of NEXT_PUBLIC_* variables.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-5-mini
AI_SUGGESTIONS_PER_HOUR=20
OPENAI_VISUALIZATION_MODEL=gpt-image-2
OPENAI_VISUALIZATION_SIZE=1536x1024
OPENAI_VISUALIZATION_QUALITY=medium
AI_VISUALIZATIONS_PER_HOUR=10

# Workers
ASSET_WORKER_CONCURRENCY=2
EXPORT_WORKER_CONCURRENCY=2
FORMAT_EXPORT_TIMEOUT_MS=120000
RENDER_WORKER_CONCURRENCY=1
GEOMETRY_WORKER_CONCURRENCY=1
AI_VISUALIZATION_WORKER_CONCURRENCY=1
PYTHON_BIN=python3
BLENDER_BIN=blender
