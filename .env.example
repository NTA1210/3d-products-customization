DATABASE_URL=postgresql://postgres:postgres@localhost:5432/product3d
REDIS_URL=redis://localhost:6379

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=product3d
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

NEXT_PUBLIC_API_URL=http://localhost:4000
MAX_ASSET_BYTES=262144000

# AI is server-side only. Keep OPENAI_API_KEY out of NEXT_PUBLIC_* variables.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_DESIGN_MODEL=gpt-5-mini
AI_SUGGESTIONS_PER_HOUR=20
OPENAI_VISUALIZATION_MODEL=gpt-image-2
OPENAI_VISUALIZATION_SIZE=1536x1024
OPENAI_VISUALIZATION_QUALITY=medium
AI_VISUALIZATIONS_PER_HOUR=10

# Workers
ASSET_WORKER_CONCURRENCY=2
EXPORT_WORKER_CONCURRENCY=2
RENDER_WORKER_CONCURRENCY=1
GEOMETRY_WORKER_CONCURRENCY=1
AI_VISUALIZATION_WORKER_CONCURRENCY=1
PYTHON_BIN=python3
BLENDER_BIN=blender
