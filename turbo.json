{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "SUPABASE_URL",
    "SUPABASE_PUBLISHABLE_KEY",
    "SUPABASE_SECRET_KEY",
    "SUPABASE_STORAGE_BUCKET",
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_API_URL",
    "MAX_ASSET_BYTES",
    "ASSET_TRIANGLE_WARNING_THRESHOLD",
    "ASSET_TEXTURE_RESOLUTION_WARNING_THRESHOLD",
    "ASSET_TEXTURE_BYTES_WARNING_THRESHOLD",
    "ASSET_ROOT_SCALE_MIN",
    "ASSET_ROOT_SCALE_MAX",
    "METRICS_SAMPLE_LIMIT",
    "METRICS_BEARER_TOKEN",
    "AI_PROVIDER",
    "OPENAI_API_KEY",
    "OPENAI_DESIGN_MODEL",
    "AI_SUGGESTIONS_PER_HOUR",
    "OPENAI_VISUALIZATION_MODEL",
    "OPENAI_VISUALIZATION_SIZE",
    "OPENAI_VISUALIZATION_QUALITY",
    "AI_VISUALIZATIONS_PER_HOUR",
    "ASSET_WORKER_CONCURRENCY",
    "EXPORT_WORKER_CONCURRENCY",
    "FORMAT_EXPORT_TIMEOUT_MS",
    "RENDER_WORKER_CONCURRENCY",
    "GEOMETRY_WORKER_CONCURRENCY",
    "AI_VISUALIZATION_WORKER_CONCURRENCY",
    "PYTHON_BIN",
    "BLENDER_BIN"
  ],
  "tasks": {
    "dev": {"cache": false, "persistent": true},
    "build": {"dependsOn": ["^build"], "outputs": [".next/**", "dist/**"]},
    "test": {"dependsOn": ["^build"], "outputs": []},
    "lint": {"outputs": []}
  }
}
